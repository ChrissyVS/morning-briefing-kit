# Copy this file to .env and fill it in. Never share .env.

# Claude: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ElevenLabs: elevenlabs.io → Developers → API Keys
ELEVENLABS_API_KEY=

# Newsletter inbox (optional). Gmail: turn on 2-step verification, then create an app password.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=

# Notion sources table (optional; without it sources.yaml is used)
NOTION_TOKEN=
NOTION_SOURCES_DB=
